# =============================================================================
# ADD THESE LINES TO YOUR PRODUCTION .env FILE
# =============================================================================

# Gemini AI Search (Required for AI-powered search)
GEMINI_API_KEY=your_gemini_api_key_here

# Deep Linking Configuration (Required for App Links)
ANDROID_PACKAGE_NAME=com.yoola.app
ANDROID_SHA256_FINGERPRINT=YOUR_SHA256_FINGERPRINT_HERE
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID_HERE
IOS_BUNDLE_ID=com.yoola.app

# =============================================================================
# HOW TO GET THESE VALUES:
# =============================================================================
#
# GEMINI_API_KEY:
#   1. Go to https://makersuite.google.com/app/apikey
#   2. Create a new API key
#   3. Copy and paste it here
#
# ANDROID_SHA256_FINGERPRINT:
#   Run this command with your release keystore:
#   keytool -list -v -keystore your-release-key.keystore -alias your-key-alias
#   Copy the SHA256 fingerprint (format: XX:XX:XX:XX:...)
#
# APPLE_TEAM_ID:
#   1. Go to Apple Developer Portal
#   2. Navigate to Membership
#   3. Copy your Team ID
#
# =============================================================================
