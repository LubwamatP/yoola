# =============================================================================
# YOOLA DEEP LINKING CONFIGURATION
# =============================================================================
# Add these lines to your .env file on the production server
# =============================================================================

# -----------------------------------------------------------------------------
# ANDROID APP LINKS
# -----------------------------------------------------------------------------
# Package name must match your Flutter app's applicationId
ANDROID_PACKAGE_NAME=com.yoola.app

# SHA256 fingerprint of your release signing key
# To get this, run:
# keytool -list -v -keystore /path/to/release-key.keystore -alias your-alias
# Copy the SHA256 fingerprint (keep the colons)
ANDROID_SHA256_FINGERPRINT=14:6D:E9:83:C5:C2:E8:93:1A:2B:3C:4D:5E:6F:7A:8B:9C:0D:1E:2F:3A:4B:5C:6D:7E:8F:9A:0B:1C:2D:3E:4F

# -----------------------------------------------------------------------------
# iOS UNIVERSAL LINKS
# -----------------------------------------------------------------------------
# Your Apple Developer Team ID (10 characters)
# Find it at: https://developer.apple.com/account → Membership → Team ID
APPLE_TEAM_ID=ABC123XYZ0

# Your iOS app Bundle Identifier (must match Xcode project)
IOS_BUNDLE_ID=com.yoola.app
