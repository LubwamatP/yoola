# =============================================================================
# PUBSPEC.YAML ADDITIONS FOR DEEP LINKING
# =============================================================================
#
# Add these dependencies to your existing pubspec.yaml file
#
# =============================================================================

dependencies:
  # Deep linking support
  uni_links: ^0.5.1

  # Navigation (choose one):

  # Option 1: go_router (Recommended for complex navigation)
  go_router: ^13.0.0

  # Option 2: auto_route (Alternative)
  # auto_route: ^7.8.0

# =============================================================================
# After adding, run:
# flutter pub get
# =============================================================================
